# ==============================================================================
# MEDIKIOSK ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# IMPORTANT: Never commit .env.local or sensitive credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="MediKiosk Clinical Intake"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="en" # "en" or "hi"
NEXT_PUBLIC_ENABLE_AYUSH_MODE="true"
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & AUTH (Optional for local demo, required for cloud DB)
# ------------------------------------------------------------------------------
# Obtain from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ------------------------------------------------------------------------------
# 3. AI REASONING & LLM ENGINE (Optional - defaults to 'mock' rule engine)
# ------------------------------------------------------------------------------
# Supported values: "mock", "anthropic"
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# 4. OCR & DOCUMENT EXTRACTION ENGINE (Optional - defaults to 'mock' parser)
# ------------------------------------------------------------------------------
# Supported values: "mock", "google_vision", "aws_textract", "tesseract"
OCR_PROVIDER="mock"
GOOGLE_APPLICATION_CREDENTIALS=""

# ------------------------------------------------------------------------------
# 5. SPEECH RECOGNITION & SYNTHESIS (ASR / TTS)
# ------------------------------------------------------------------------------
# Supported values: "browser_web_speech", "mock", "azure_speech"
SPEECH_PROVIDER="browser_web_speech"
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""

# ------------------------------------------------------------------------------
# 6. ABDM / FHIR INTEROPERABILITY GATEWAY (Future Sandbox)
# ------------------------------------------------------------------------------
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_GATEWAY_URL="https://dev.abdm.gov.in/gateway"
